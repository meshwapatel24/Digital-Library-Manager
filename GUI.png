,\"version\":37,\"id_type\":\"stableID\",\"value\":{},\"is_device_based\":true,\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"3337546492\":{\"name\":\"3337546492\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":9,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1441592107\":{\"name\":\"1441592107\",\"rule_id\":\"6j1mnlu6KrLzVPkdYVwN03\",\"secondary_exposures\":[],\"version\":1376,\"id_type\":\"stableID\",\"value\":{\"should_disable_google_one_tap_on_mobile_web\":true},\"is_device_based\":true,\"group_name\":\"test\"},\"3333071866\":{\"name\":\"3333071866\",\"rule_id\":\"4kPI1bhuuaWmfMGKacBGKo\",\"secondary_exposures\":[{\"gate\":\"1859514078\",\"gateValue\":\"true\",\"ruleID\":\"6r6LVMJTYYmSqi2csuF3f6\"}],\"version\":90,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"1171720776\":{\"name\":\"1171720776\",\"rule_id\":\"1UlyxmDKitlLIkNkLWdoOF\",\"secondary_exposures\":[],\"version\":17,\"id_type\":\"stableID\",\"value\":{\"enabled\":false},\"is_device_based\":true,\"group_name\":\"Test\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"216490582\":{\"name\":\"216490582\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"url\":\"https://help.openai.com/articles/20001509\"},\"is_device_based\":false,\"passed\":false},\"383746455\":{\"name\":\"383746455\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":5,\"id_type\":\"userID\",\"value\":{\"disable_hover_previews\":false,\"disable_image_thumbnails\":false,\"disable_local_indexing\":false},\"is_device_based\":false,\"passed\":false},\"364966874\":{\"name\":\"364966874\",\"rule_id\":\"1RZoUs3fJLPVVcW62fVYp4\",\"secondary_exposures\":[],\"version\":29,\"id_type\":\"userID\",\"value\":{\"new_static_onboarding_flow\":fa