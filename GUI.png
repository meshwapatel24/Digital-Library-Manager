",\"RE\",\"RO\",\"RS\",\"RW\",\"SA\",\"SB\",\"SC\",\"SD\",\"SE\",\"SG\",\"SH\",\"SI\",\"SJ\",\"SK\",\"SL\",\"SM\",\"SN\",\"SO\",\"SR\",\"SS\",\"ST\",\"SV\",\"SX\",\"SZ\",\"TC\",\"TD\",\"TF\",\"TG\",\"TH\",\"TJ\",\"TK\",\"TL\",\"TM\",\"TN\",\"TO\",\"TR\",\"TT\",\"TV\",\"TW\",\"TZ\",\"UA\",\"UG\",\"UM\",\"US\",\"UY\",\"UZ\",\"VA\",\"VC\",\"VG\",\"VI\",\"VN\",\"VU\",\"WF\",\"WS\",\"XK\",\"YE\",\"YT\",\"YU\",\"ZA\",\"ZM\",\"ZW\"]},\"is_device_based\":true,\"passed\":false},\"3317473948\":{\"name\":\"3317473948\",\"rule_id\":\"2VVKrjIwc2VcBceUZhfkJB:100.00:3\",\"secondary_exposures\":[],\"version\":26,\"id_type\":\"userID\",\"value\":{\"model_slug_max_polling_durations\":{\"o3_pro\":1200,\"o1_pro\":1200,\"image_gen\":300},\"local_conversation_insert_fallback_disabled_system_hints\":[\"agent\"],\"polling_fallback_on_message_insertion_error\":[{\"fallback_mode\":\"final_assistant_answer\"}],\"default_max_polling_duration\":200,\"model_slug_intervals\":{\"image_gen\":10,\"gpt_4o\":2},\"default_interval\":5},\"is_device_based\":false,\"passed\":true},\"1408180753\":{\"name\":\"1408180753\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{\"usage_scaling_multiplier\":0,\"base_interval_ms\":60000,\"poll_in_background\":false},\"is_device_based\":false,\"passed\":false},\"2995592449\":{\"name\":\"2995592449\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1542892414\":{\"name\":\"1542892414\",\"rule_id\":\"LpHHFWoF1a98uGqwL1FVt:100.00:1-LpHHEhmcJ0EP58uVD62Cr\",\"secondary_exposures\":[],\"version\":6,\"id_type\":\"userID\",\"value\":{\"sample_rate\":0.1,\"enabled\":true},\"is_device_based\":false,\"passed\":true},\"2688454279\":{\"name\":\"2688454279\",\"rule_id\":\"35Dg2O0a0xbncUKLdHChWi:100.00:6-35Dg2Ml7yf1STvcPCzGEDg\",\"secondary_exposures\":[{\"gate\":\"3214226695\",\"gateValue\"