ondary_exposures\":[{\"gate\":\"1007700932\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":110,\"id_type\":\"userID\",\"value\":{\"enable_service_connectors\":false,\"enable_mcps\":false,\"citation_output_processor\":true,\"enable_toggle_p13n_connectors\":true,\"mcps_prompt_override\":\"\"},\"is_device_based\":false,\"passed\":false},\"3543489707\":{\"name\":\"3543489707\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1970737597\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":431,\"id_type\":\"userID\",\"value\":{\"bestbuy\":\"asdk_app_6a5e8374ba288191a9ee2867002c808e\",\"opentable\":\"asdk_app_6935ba0e15b48191ae8ad5795b213c19\",\"walmart\":\"asdk_app_69b0921773588191a651c86809c15ed7\",\"yelp\":\"asdk_app_69e92b0ca8708191a9c3259e162d8e2d\",\"sams\":\"asdk_app_6a3eb4bdbe688191badec8f7642fa3a9\",\"resy\":\"asdk_app_69c1b187eab4819187448a269e653a74\"},\"is_device_based\":false,\"passed\":false},\"3583985244\":{\"name\":\"3583985244\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":66,\"id_type\":\"workspace_id\",\"value\":{\"permissions\":[{\"permission\":\"chatgpt.workspace.model.GPT-4.1.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-4.1-mini.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-4.5.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5-pro.access\"},{\"disable_for_quorum\":true,\"permission\":\"chatgpt.workspace.model.GPT-5-reasoning-mini.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5-reasoning.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5.1-pro.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5.1-reasoning.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5.1.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5.2-pro.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5.2-reasoning.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5.2.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5.2.instant.access\"},{\"permission\"