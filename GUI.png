openai.com/chatgpt/clients/bazaar/onboarding/secure.png\",\"card_image_url\":\"https://cdn.openai.com/chatgpt/clients/onboarding/onboarding-example-1.png\",\"screen_trust_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/trusted_en.png\"},\"ask_chatgpt_system_message\":\"The user is referring to an ad shown to them about: {LABEL}. Your response MUST BE ABOUT THE ADS shown, since the user explicitly asked about them. They are using the 'Ask ChatGPT' feature and you must reply to the user query using the information about the ads, which is:\\n{DATA}\\n\\nFor example: if the user asks 'Tell me more about these' (or other wordings), then your answer should be about details or further information on products, services, locations etc described in the ad and the links in the ad.\"},\"is_device_based\":false,\"passed\":true},\"1821234005\":{\"name\":\"1821234005\",\"rule_id\":\"3sBs88SylWKvNuRCkwZi6W\",\"secondary_exposures\":[{\"gate\":\"3743432195\",\"gateValue\":\"true\",\"ruleID\":\"14L7KJMWMGpXyyNZOAVNaE\"}],\"version\":28,\"id_type\":\"stableID\",\"value\":{\"encoding\":\"identity\"},\"is_device_based\":true,\"group_name\":\"Control\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"690794452\":{\"name\":\"690794452\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[{\"gate\":\"1698194209\",\"gateValue\":\"true\",\"ruleID\":\"4jgEf5238tltXPRCHOgJIK:100.00:1\"},{\"gate\":\"700086370\",\"gateValue\":\"false\",\"ruleID\":\"4wjMPWEmtXprtoT3hazryq:5.00:1\"},{\"gate\":\"3643162575\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"4136617744\",\"gateValue\":\"false\",\"ruleID\":\"2XRAjoNcg3mG38o39UgN4Z\"},{\"gate\":\"2958953032\",\"gateValue\":\"true\",\"ruleID\":\"5307jVlQCqV55kmlqhlQqk\"}],\"version\":30,\"id_type\":\"userID\",\"value\":{\"enabled\":true,\"sunspot-default-on\":false,\"default_personalized\":true,\"preserve_moderation_on_save\":true},\"is_device_based\":false,\"is_in_layer\":true,\"explicit_parameters\":[\"enabled\",\"default_personalized\"],\"group_name\":\"Personalization default on\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1628125068\":{\"name\":\"1628125068\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":{\"allow_invite_purchases\":true,\"blocked_card_issuer_countries\":[\"IN\"],\"allowed_payment_method_types\":[\"card\"]},\"is_device_based\":false,\"passed\":false},\"208167308\":{\"name\":\"208167308\",\"rule_id\":\"67iWaPBF06omWkZCcVwwu4:100.00:31-67iWaNWCxOeSCVrGBNATb2\",\"secondary_exposures\":[{\"gate\":\"3029657650\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2274846837\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3901104270\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1893643243\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2054053781\",\"gateValue\":\"false\",\"ruleID\":\"TDkD30SOgtZKsddyBr7eR\"},{\"gate\":\"1326334369\",\"gateValue\":\"false\",\"ruleID\":\"2B5IWstAbskebXDLAuIct8\"},{\"gate\":\"957497898\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1833787017\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":627,\"id_type\":\"userID\",\"value\":{\"json_completion_prompt\":\"Complete the automation's work on every run, whether or not there is an update to send.\\nUse the user's instructions to decide whether this run warrants notifying them, including\\nrequested reminders and meaningful findings or changes.\\n\\nWhen the user should be notified, write your normal final response.\\nWhen no notification is needed but the response should appear in the user's conversation history,\\nmake your entire final response this JSON object with exactly these fields:\\n{\\\"type\\\": \\\"skip_notification\\\", \\\"reason\\\": \\\"Your full response to the task\\\"}.\\nWhen there is no useful update to add to the user's conversation history, omit reason and make your\\nentire final response {\\\"type\\\": \\\"skip_notification\\\"}. Do not wrap the JSON in a code fence or add\\ntext outside it.\\n\\nWrite reason as a fully natural assistant response addressed to the user. Include the useful\\nfindings, details of the work you did, and relevant limitations or next steps, with the same\\ndetail you would normally provide for the task. This response remains available in the run's\\nhistory. It does not need to justify skipping a notification or discuss notification mechanics.\\nUse normal prose and Markdown within the JSON string, escaping it as valid JSON.\",\"virtual_model_override\":\"gpt-5.6-luna-1p-chat-ev3\",\"automation_capabilities\":{\"allowed_timing_modes\":[\"flexible_schedule\"],\"allowed_frequencies\":[\"once\",\"daily\",\"weekly\",\"monthly\",\"yearly\"]},\"private_peek_enabled\":true,\"exact_schedule_proactive_start_offset_seconds\":0,\"personalized_task_card_read_timeout_seconds\":0.225,\"break_plugin_service_brte_history_chain\":true,\"legacy_completion_prompt\":\"If you do not have an update for the user during this automation turn, you must emit `::SKIP_COMPLETION::`. UNLESS you have clarifying questions for the user that will help you perform your task - in which case, feel free to ask that question. \\n\\nExamples for when to output `::SKIP_COMPLETION::`:\\n- If the user asks you to let them know when a reservation opens up at Cotogna at a specific time, and you find out that there is still no reservation available\\n- If the user asks you to let them know when they have a new email but there are no new emails since your last run\\n\\nThe `::SKIP_COMPLETION::` logic should only apply to this turn. This guidance is no longer applicable after the next user turn.\",\"automations_list_limit\":25,\"additional_developer_message_prompt\":\"If you do not have an update for the user during this automation turn, you must emit `::SKIP_COMPLETION::`. UNLESS you have clarifying questions for the user that will help you perform your task - in which case, feel free to ask that question. \\n\\nExamples for when to output `::SKIP_COMPLETION::`:\\n- If the user asks you to let them know when a reservation opens up at Cotogna at a specific time, and you find out that there is still no reservation available\\n- If the user asks you to let them know when they have a new email but there are no new emails since your last run\",\"automations_list_tool_additional_guidance\":\"Do not call the automations `list` action again this turn; use the automations `peek` action for any further inspection.\",\"max_active_automations\":3,\"max_turns_per_conversation\":175,\"automations_create_plan_tool_additional_guidance\":\"The user has created an automation for an ongoing goal with a private plan. Collaborate with the user across turns, use available structured context to understand their goals and prior progress, and help advance the saved plan.\",\"skip_completion_text\":\"::SKIP_COMPLETION::\",\"model_id_override\":\"mainline_managed.current_gpt5_6_reasoning_luna\"},\"is_device_based\":false,\"passed\":true},\"3332590463\":{\"name\":\"3332590463\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"max_page_age_seconds\":259200},\"is_device_based\":false,\"passed\":false},\"3012059064\":{\"name\":\"3012059064\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":9,\"id_type\":\"userID\",\"value\":{\"billing_starts_at\":\"\",\"show_notice\":false},\"is_device_based\":false,\"passed\":false},\"734083401\":{\"name\":\"734083401\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":16,\"id_type\":\"userID\",\"value\":{\"enabled\":true,\"kind\":\"username\",\"loginStrategy\":\"existing_user\",\"tempDisabled\":false,\"name\":\"email\"},\"is_device_based\":false,\"passed\":false},\"3747383021\":{\"name\":\"3747383021\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"733205176\",\"gateValue\":\"false\",\"ruleID\":\"1PJvsr1PFO2C35xU6YPcnd\"}],\"version\":18